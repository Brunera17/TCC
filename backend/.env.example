# Copie este arquivo para .env e preencha com valores reais.
# NUNCA faça commit do arquivo .env — ele já está no .gitignore.

# Flask application secrets
# Gere valores aleatórios fortes, por exemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
REFRESH_SECRET_KEY=

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis connection settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Se true, a aplicação falha ao iniciar quando o Redis estiver indisponível
REDIS_REQUIRED=false

# Token de acesso do Mercado Pago (obtenha no painel do Mercado Pago)
MERCADOPAGO_ACCESS_TOKEN=
